# Lightning AI GPU 训练配置（复制为 .env 或 .lightning_env 并填入真实值）

# Lightning 账号凭证（API）
LIGHTNING_USER_ID=<your-user-id>
LIGHTNING_API_KEY=<your-api-key>

# Lightning Studio（GPU 训练机）
LIGHTNING_STUDIO_NAME=<your-studio-name>
LIGHTNING_TEAMSPACE=<your-account>/<your-teamspace>

# LLM 网关（数据合成）与 Jev（打标）的 key 分别放在 .key / .jev_key（均 gitignore）
